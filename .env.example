# Supabase Integration: Cloud PostgreSQL database and real-time synchronization
# Obtain from your Supabase project dashboard -> Settings -> API
# After setting these, run supabase-schema.sql, then
# supabase-schema-v2-security-fix.sql, then
# supabase-schema-v3-claim-shop-fix.sql in the Supabase SQL Editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Super Admin login for the local SaaS admin dashboard (src/components/admin).
# Leave both blank to disable super admin login entirely (recommended
# unless you actually use that dashboard). Generate the hash with:
#   crypto.subtle.digest('SHA-256', new TextEncoder().encode('yourpassword'))
#     .then(buf => console.log([...new Uint8Array(buf)]
#       .map(b => b.toString(16).padStart(2, '0')).join('')));
# Never commit real values here - this file is the *example* only.
VITE_SUPERADMIN_EMAIL=
VITE_SUPERADMIN_PASSWORD_HASH=
